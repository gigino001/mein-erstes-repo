# Kopieren nach .env und ausfüllen.
# Lokale Entwicklung: SQLite-Datei (kein Server nötig).
# Vor dem Deploy auf ALL-INKL: provider in prisma/schema.prisma auf "mysql"
# umstellen und hier die echte MySQL/MariaDB-Verbindung eintragen.
DATABASE_URL="file:./dev.db"

# Admin-Login (/admin) — siehe README für Einrichtung.
# Wert erzeugen: npm run admin:hash-password -- "DeinPasswort"
# (Ausgabe ist bereits Base64-kodiert — wichtig, sonst verstümmelt Next.js'
# .env-Loader die "$"-Zeichen im bcrypt-Hash.)
ADMIN_PASSWORD_HASH=""
# Zufälligen Secret-String erzeugen: openssl rand -base64 32
SESSION_SECRET=""

# E-Mail-Versand (Terminanfragen + Bestätigungen). Ohne diese Werte werden
# Mails nur in die Konsole geloggt statt verschickt (lokale Entwicklung).
# Bei ALL-INKL: SMTP-Zugangsdaten des E-Mail-Postfachs aus dem KAS
# ("E-Mail-Konten" → Postfach → Einstellungen), üblich sind:
#   SMTP_HOST="w0123456.kasserver.com"  (dein ALL-INKL-Server, siehe KAS)
#   SMTP_PORT="587"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""


