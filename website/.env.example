# Kopieren nach .env und ausfüllen.
# Lokale Entwicklung: `docker compose up -d` startet eine lokale Postgres-DB
# mit genau diesen Zugangsdaten (siehe docker-compose.yml). Auf Netlify wird
# die Datenbank automatisch bereitgestellt (siehe README, Abschnitt
# "Netlify-Preview") — dort ist keine DATABASE_URL nötig. Für die geplante
# ALL-INKL-Produktion (MySQL/MariaDB) muss der Provider vorher zurückgestellt
# werden, siehe README.
DATABASE_URL="postgresql://cocolashes:cocolashes_dev_pw@127.0.0.1:5432/cocolashes"

# Admin-Login (/admin) — siehe README für Einrichtung.
# Wert erzeugen: npm run admin:hash-password -- "DeinPasswort"
# (Ausgabe ist bereits Base64-kodiert — wichtig, sonst verstümmelt Next.js'
# .env-Loader die "$"-Zeichen im bcrypt-Hash.)
ADMIN_PASSWORD_HASH=""
# Zufälligen Secret-String erzeugen: openssl rand -base64 32
SESSION_SECRET=""

# E-Mail-Versand (Terminanfragen + Bestätigungen). Ohne diese Werte werden
# Mails nur in die Konsole geloggt statt verschickt (lokale Entwicklung).
# Bei ALL-INKL: SMTP-Zugangsdaten des E-Mail-Postfachs aus dem KAS
# ("E-Mail-Konten" → Postfach → Einstellungen), üblich sind:
#   SMTP_HOST="w0123456.kasserver.com"  (dein ALL-INKL-Server, siehe KAS)
#   SMTP_PORT="587"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Anzahlung bei Terminbuchung (aktuell nur Neumodellage, 50 % des Preises).
# Ohne diese Werte ist die Online-Anzahlung deaktiviert und Buchungen für
# betroffene Leistungen schlagen mit einer Fehlermeldung fehl — Buchungen
# ohne Anzahlungspflicht funktionieren wie gewohnt.
# STRIPE_SECRET_KEY: Stripe-Dashboard → Entwickler → API-Schlüssel (sk_test_…
#   zum Testen, sk_live_… für den echten Betrieb).
# STRIPE_WEBHOOK_SECRET: Stripe-Dashboard → Entwickler → Webhooks → Endpunkt
#   hinzufügen mit der URL "<eigene-domain>/api/stripe-webhook" und dem
#   Ereignis "checkout.session.completed" → das dabei angezeigte
#   Signing Secret (whsec_…) hier eintragen.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

