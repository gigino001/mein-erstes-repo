// coco lashes — Datenmodell
// Produktionsplan: MySQL/MariaDB (lokal per Docker, auf ALL-INKL gegen die
// dort bereitgestellte MariaDB). Für den Netlify-Preview läuft dieselbe
// Datenbank stattdessen gegen Postgres (automatisch von Netlify DB
// bereitgestellt, siehe src/lib/prisma.ts) — daher hier "postgresql".
//
// Hinweis: MySQL/MariaDB und Postgres kennen zwar native Enums, wir führen
// "category" und "status" trotzdem bewusst als String mit dokumentierten,
// festen Werten — das hält das Schema portabel und Änderungen an den Werten
// brauchen keine Migration.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native" für lokale Entwicklung/Builds (Debian hier); "rhel-openssl-3.0.x"
  // zusätzlich, weil Netlify Functions (Next.js Runtime) auf einer anderen
  // Plattform laufen als der Netlify-Build-Container selbst.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())

  availabilities Availability[]
  exceptions     AvailabilityException[]
  appointments   Appointment[]
}

model Service {
  id              String   @id @default(cuid())
  name            String
  /// "neumodellage" | "auffuellen" | "sonstiges"
  category        String
  durationMinutes Int
  priceCents      Int
  description     String?  @db.Text
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  appointments Appointment[]
}

/// Wiederkehrende Arbeitszeiten je Mitarbeiterin und Wochentag.
model Availability {
  id           String @id @default(cuid())
  staffId      String
  /// 0 = Sonntag … 6 = Samstag
  weekday      Int
  /// Minuten seit Mitternacht, z. B. 10:00 Uhr = 600
  startMinute  Int
  endMinute    Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

/// Ausnahmen von den regulären Arbeitszeiten: Urlaub, Feiertage, spontane
/// Blocker oder erweiterte Zeiten an einem bestimmten Datum.
model AvailabilityException {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime
  /// true = der ganze Tag ist blockiert (z. B. Urlaub)
  allDay      Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  reason      String?  @db.Text

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Appointment {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  serviceId     String
  staffId       String
  startAt       DateTime
  endAt         DateTime
  /// "requested" | "confirmed" | "cancelled"
  status        String   @default("requested")
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([staffId, startAt])
}
