// coco lashes — Datenmodell
// Produktionsplan: MySQL/MariaDB (lokal per Docker, auf ALL-INKL gegen die
// dort bereitgestellte MariaDB). Für den Netlify-Preview läuft dieselbe
// Datenbank stattdessen gegen Postgres (automatisch von Netlify DB
// bereitgestellt, siehe src/lib/prisma.ts) — daher hier "postgresql".
//
// Hinweis: MySQL/MariaDB und Postgres kennen zwar native Enums, wir führen
// "category" und "status" trotzdem bewusst als String mit dokumentierten,
// festen Werten — das hält das Schema portabel und Änderungen an den Werten
// brauchen keine Migration.

// Driver Adapters (queryCompiler + "pg") statt der nativen Query-Engine-Binary:
// Netlify Functions laufen auf einer anderen Plattform als der Netlify-Build-
// Container (Debian vs. RHEL), was mit der nativen Engine trotz binaryTargets
// zuverlässig zu "Query Engine not found"-Fehlern zur Laufzeit führte. Der
// Driver Adapter spricht stattdessen direkt über den "pg"-Treiber mit
// Postgres, keine plattformspezifische Binary nötig.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())

  availabilities Availability[]
  exceptions     AvailabilityException[]
  appointments   Appointment[]
}

model Service {
  id              String   @id @default(cuid())
  name            String
  /// "neumodellage" | "auffuellen" | "sonstiges"
  category        String
  durationMinutes Int
  priceCents      Int
  description     String?  @db.Text
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  appointments Appointment[]
}

/// Wiederkehrende Arbeitszeiten je Mitarbeiterin und Wochentag.
model Availability {
  id           String @id @default(cuid())
  staffId      String
  /// 0 = Sonntag … 6 = Samstag
  weekday      Int
  /// Minuten seit Mitternacht, z. B. 10:00 Uhr = 600
  startMinute  Int
  endMinute    Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

/// Ausnahmen von den regulären Arbeitszeiten: Urlaub, Feiertage, spontane
/// Blocker oder erweiterte Zeiten an einem bestimmten Datum.
model AvailabilityException {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime
  /// true = der ganze Tag ist blockiert (z. B. Urlaub)
  allDay      Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  reason      String?  @db.Text

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Appointment {
  id                String   @id @default(cuid())
  customerName      String
  customerEmail     String
  customerPhone     String?
  customerInstagram String?
  serviceId         String
  staffId           String
  startAt           DateTime
  endAt             DateTime
  /// "requested" | "confirmed" | "cancelled"
  status            String   @default("requested")
  note              String?  @db.Text
  /// Anzahlung in Cent, falls für die gebuchte Leistung fällig (0 = keine).
  depositAmountCents Int     @default(0)
  /// Stripe PaymentIntent-ID der Anzahlung, für Rückerstattung bei Stornierung.
  stripePaymentIntentId String?
  /// Zeitpunkt, zu dem die Bewertungs-Anfrage-Mail (2 Tage nach dem Termin) verschickt wurde.
  reviewRequestSentAt DateTime?
  createdAt         DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([staffId, startAt])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  priceCents  Int
  imageUrl    String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

model Order {
  id                 String   @id @default(cuid())
  customerName       String
  customerEmail      String
  customerPhone      String?
  /// "pickup" | "shipping"
  fulfillment        String
  shippingStreet     String?
  shippingPostalCode String?
  shippingCity       String?
  /// Versandkosten in Cent, die zum Bestellzeitpunkt galten (0 bei Abholung).
  shippingCostCents  Int      @default(0)
  itemsTotalCents    Int
  totalCents         Int
  /// "paid" | "completed"
  status             String   @default("paid")
  stripePaymentIntentId String?
  createdAt          DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  /// Name/Preis zum Bestellzeitpunkt — bleibt erhalten, falls sich das
  /// Produkt später ändert.
  productName    String
  unitPriceCents Int
  quantity       Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// Ein einzelner Datensatz (id = "singleton") für Shop-weite Einstellungen.
model ShopSettings {
  id                String  @id @default("singleton")
  /// Versand ist bewusst standardmäßig deaktiviert — dafür sind rechtliche
  /// Vorbereitungen nötig (Widerrufsrecht, ggf. LUCID-Registrierung). Erst
  /// nach bewusster Aktivierung im Admin-Bereich wird Versand im Shop
  /// angeboten.
  shippingEnabled   Boolean @default(false)
  shippingCostCents Int     @default(495)
}
