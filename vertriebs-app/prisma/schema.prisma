// Datenmodell für die PV- und Wärmepumpen-Vertriebs-App

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Benutzer ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SALES") // ADMIN | SALES
  createdAt    DateTime @default(now())

  customers        Customer[]
  projects         Project[]
  assignedTasks    Task[]     @relation("TaskAssignee")
  createdTasks     Task[]     @relation("TaskCreator")
  uploadedDocuments Document[]
}

// ---------- Kunden (CRM) ----------

model Customer {
  id                       String    @id @default(cuid())
  salutation               String? // Herr, Frau, Firma
  firstName                String
  lastName                 String
  company                  String?
  street                   String?
  postalCode               String?
  city                     String?
  phone                    String?
  email                    String?
  buildingType             String? // EFH, DHH, MFH, GEWERBE
  buildYear                Int?
  contactPerson            String?
  notes                    String?
  pipelineStatus           String    @default("INTERESSENT") // INTERESSENT | TERMIN | ANGEBOT | WIEDERVORLAGE | KUNDE
  followUpDate             DateTime? // Wiedervorlage-Datum
  usageType                String    @default("SELBSTGENUTZT") // SELBSTGENUTZT | VERMIETET (für Förderfähigkeit)
  annualHouseholdIncomeEur Float? // zu versteuerndes Jahreseinkommen (für Einkommens-Bonus Wärmepumpe)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  projects Project[]
}

// ---------- Auftragsvarianten: Status-Workflows ----------

// Jede Auftragsvariante (PV, Wärmepumpe, ...) hat einen eigenen,
// frei konfigurierbaren Satz an Status-Schritten.
model StatusDefinition {
  id          String  @id @default(cuid())
  variantType String // PV | WAERMEPUMPE | KLIMA | WARTUNG | ELEKTROINSTALLATION | HEIZUNG_SANITAER_NEUBAU
  name        String
  sortOrder   Int     @default(0)
  isTerminal  Boolean @default(false)
  color       String?

  projectVariants ProjectVariant[]
}

// ---------- Projekt (kann mehrere Auftragsvarianten bündeln) ----------

// Ein Vorgang kann mehrere Leistungen zusammenfassen (z.B. PV + Wärmepumpe +
// Wartung in einem Auftrag). Jede enthaltene Leistung bekommt über
// ProjectVariant einen eigenen Status im jeweiligen Auftragsvarianten-
// Workflow; Kostenpositionen, Preisfindung und Angebot bleiben je Vorgang
// gebündelt (ein gemeinsames Angebot für alle Leistungen).
model Project {
  id             String    @id @default(cuid())
  title          String? // z.B. "PV Musterstraße 1"
  offerExpiresAt DateTime? // Gültigkeit des zuletzt versendeten Angebots
  isNewBuilding  Boolean   @default(false) // Neubau vs. Bestandsgebäude (für Förderfähigkeit)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  variants     ProjectVariant[]
  pvData       PvData?
  heatPumpData HeatPumpData?
  climaData    ClimaData?
  costItems    CostItem[]
  pricing      Pricing?
  offers       Offer[]
  tasks        Task[]
  documents    Document[]
}

// Eine im Vorgang enthaltene Leistung (Auftragsvariante) mit eigenem Status.
model ProjectVariant {
  id          String @id @default(cuid())
  variantType String // PV | WAERMEPUMPE | KLIMA | WARTUNG | ELEKTROINSTALLATION | HEIZUNG_SANITAER_NEUBAU

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId String
  status   StatusDefinition @relation(fields: [statusId], references: [id])

  @@unique([projectId, variantType])
}

// ---------- PV-Daten ----------

model PvData {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Dach
  roofMaterial String?

  // Verbrauch
  annualConsumptionKwh Float?
  personsCount         Int?
  homeOffice           Boolean @default(false)
  hasHeatPumpExisting  Boolean @default(false)
  hasWallbox           Boolean @default(false)
  hasPool              Boolean @default(false)
  hasAirConditioning   Boolean @default(false)

  // Netz
  gridOperator           String?
  meterCabinetSufficient Boolean?
  threePhase             Boolean?
  gridConnectionPowerKw  Float?

  // Kundenwunsch
  goalMaxSelfSupply  Boolean @default(false)
  goalMaxYield       Boolean @default(false)
  goalBackupPower    Boolean @default(false)
  goalEmergencyPower Boolean @default(false)
  goalLowCost        Boolean @default(false)

  // gewählte Komponenten
  moduleComponentId         String?
  moduleComponent           Component? @relation("PvModule", fields: [moduleComponentId], references: [id])
  moduleCount               Int?
  inverterComponentId       String?
  inverterComponent         Component? @relation("PvInverter", fields: [inverterComponentId], references: [id])
  storageComponentId        String?
  storageComponent          Component? @relation("PvStorage", fields: [storageComponentId], references: [id])
  wallboxComponentId        String?
  wallboxComponent          Component? @relation("PvWallbox", fields: [wallboxComponentId], references: [id])
  emsComponentId            String?
  emsComponent              Component? @relation("PvEms", fields: [emsComponentId], references: [id])
  mountingSystemComponentId String?
  mountingSystemComponent   Component? @relation("PvMounting", fields: [mountingSystemComponentId], references: [id])

  // Berechnungsergebnisse (Cache)
  calculatedKwp                Float?
  calculatedAnnualYieldKwh     Float?
  calculatedSelfConsumptionKwh Float?
  calculatedAutarkyPercent     Float?
  calculatedFeedInKwh          Float?
  calculatedFeedInRevenue      Float?
  calculatedSavingsPerYear     Float?
  calculatedAmortizationYears  Float?
  calculatedCo2SavingsKg       Float?

  roofSurfaces RoofSurface[]
}

model RoofSurface {
  id String @id @default(cuid())

  pvDataId String
  pvData   PvData @relation(fields: [pvDataId], references: [id], onDelete: Cascade)

  name          String? // "Dachfläche 1"
  roofShape     String? // SATTELDACH, WALMDACH, FLACHDACH, PULTDACH, ZELTDACH, SONSTIGE
  orientation   String? // N, NO, O, SO, S, SW, W, NW
  tiltDegrees   Float?
  areaSqm       Float?
  usableAreaSqm Float?
  shading       String? // KEINE, LEICHT, MITTEL, STARK
  sortOrder     Int     @default(0)
}

// ---------- Wärmepumpen-Daten ----------

model HeatPumpData {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Gebäude
  buildYear          Int?
  livingAreaSqm      Float?
  heatedAreaSqm      Float?
  insulationStandard String? // UNSANIERT, TEILSANIERT, SANIERT, NEUBAU
  windowType         String?
  floorsCount        Int?

  // bisherige Heizung
  currentHeatingType     String? // GAS, OEL, ELEKTRO, PELLET, FERNWAERME, SONSTIGE
  annualConsumptionValue Float?
  annualConsumptionUnit  String? // l, m3, kWh

  // Heizkörper
  heatEmitterType String? // FUSSBODENHEIZUNG, HEIZKOERPER, MISCHSYSTEM
  flowTemperature Float?

  // Warmwasser
  personsCount          Int?
  hotWaterStorageLiters Float?

  // Standort / Klima
  location          String?
  designOutdoorTemp Float?

  // Für Förderfähigkeit
  oldHeatingInstallYear Int? // Baujahr der bisherigen Heizanlage

  // gewählte Komponenten
  heatPumpComponentId String?
  heatPumpComponent   Component? @relation("HpDevice", fields: [heatPumpComponentId], references: [id])
  bufferComponentId   String?
  bufferComponent     Component? @relation("HpBuffer", fields: [bufferComponentId], references: [id])

  // Berechnungsergebnisse (Cache)
  calculatedHeatLoadKw           Float?
  calculatedAnnualConsumptionKwh Float?
  calculatedJaz                  Float?
  calculatedAnnualOperatingCost  Float?
  calculatedOldAnnualCost        Float?
  calculatedSavingsPerYear       Float?
  calculatedAmortizationYears    Float?
  calculatedCo2SavingsKg         Float?
}

// ---------- Klimaanlagen-Daten ----------

model ClimaData {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Gebäude
  insulationStandard String? // UNSANIERT, TEILSANIERT, SANIERT, NEUBAU

  // gewählte Komponente (Klimagerät/-Set)
  climaComponentId String?
  climaComponent   Component? @relation("ClimaUnit", fields: [climaComponentId], references: [id])
  unitsCount       Int?

  // Berechnungsergebnisse (Cache)
  calculatedTotalCoolingLoadKw           Float?
  calculatedRecommendedUnitsCount        Int?
  calculatedEstimatedAnnualOperatingCost Float?

  rooms KlimaRoom[]
}

model KlimaRoom {
  id String @id @default(cuid())

  climaDataId String
  climaData   ClimaData @relation(fields: [climaDataId], references: [id], onDelete: Cascade)

  name           String?
  areaSqm        Float?
  ceilingHeightM Float?
  shading        String? // KEINE, LEICHT, MITTEL, STARK (Sonneneinstrahlung/Verschattung)
  occupantsCount Int?
  hasHeatSources Boolean @default(false) // z.B. Küchengeräte, viel Elektronik
  sortOrder      Int     @default(0)

  calculatedLoadKw Float?
}

// ---------- Komponenten-Stammdaten ----------

model Component {
  id                     String   @id @default(cuid())
  category               String // MODUL, WECHSELRICHTER, SPEICHER, WALLBOX, ENERGIEMANAGER, MONTAGESYSTEM, WAERMEPUMPE, PUFFERSPEICHER, KLIMAGERAET, MONTAGE, DIENSTLEISTUNG, GARANTIE, SONSTIGES
  manufacturer           String
  name                   String
  longDescription        String? // ausführliche Beschreibung, z.B. für Angebotstexte
  price                  Float
  unit                   String   @default("Stück") // Stück, Pauschale, kWp, Stunde, je Feld, ...
  productNumber          String? // Artikel-/Produktnummer aus dem Wareneingang bzw. der Rechnungssoftware
  vatRatePercent         Float    @default(19) // Umsatzsteuersatz in %
  maxDiscountPercent     Float? // maximaler Rabatt in % auf den Preis dieser Position
  maxDiscountAmount      Float? // alternativ/zusätzlich: fester Mindestpreis, unter den nicht rabattiert werden darf
  specs                  String   @default("{}") // JSON-String mit kategorie-spezifischen Eigenschaften
  usesNaturalRefrigerant Boolean  @default(false) // für Wärmepumpen: natürliches Kältemittel (z.B. Propan/R290), relevant für Effizienzbonus
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  pvModuleFor   PvData[]       @relation("PvModule")
  pvInverterFor PvData[]       @relation("PvInverter")
  pvStorageFor  PvData[]       @relation("PvStorage")
  pvWallboxFor  PvData[]       @relation("PvWallbox")
  pvEmsFor      PvData[]       @relation("PvEms")
  pvMountingFor PvData[]       @relation("PvMounting")
  hpDeviceFor   HeatPumpData[] @relation("HpDevice")
  hpBufferFor   HeatPumpData[] @relation("HpBuffer")
  climaFor      ClimaData[]    @relation("ClimaUnit")
  costItemFor   CostItem[]
}

// ---------- Kostenpositionen ----------

model CostItem {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String // MATERIAL, MONTAGE, SONSTIGES
  description String
  amount      Float
  sortOrder   Int     @default(0)
  // gesetzt bei automatisch aus der Komponentenauswahl generierten Positionen
  // (PV, WAERMEPUMPE, KLIMA), null bei manuell erfassten Positionen
  sourceVariant String?

  // optionaler Bezug zu einer Katalog-Komponente: ermöglicht die Rabattlogik
  // (maxDiscountPercent/maxDiscountAmount an der Komponente) und die
  // automatische Preisübernahme. Bei freien Positionen bleibt das leer.
  componentId     String?
  component       Component? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  unitPrice       Float?
  quantity        Float      @default(1)
  discountPercent Float      @default(0)
}

// ---------- Preisfindung ----------

model Pricing {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  marginPercent            Float  @default(20)
  discountAmount           Float  @default(0)
  financingMonths          Int?
  financingInterestPercent Float?

  // Cache
  totalCost       Float?
  salesPrice      Float?
  monthlyRate     Float?
  // gewichteter MwSt-Satz über alle Kostenpositionen (nach Komponenten-
  // vatRatePercent, Freitext-Positionen mit 19% angenommen) + Bruttopreis
  vatRatePercent  Float?
  salesPriceGross Float?
}

// ---------- Förderprogramme ----------

// Pflegbare Stammdaten (keine Rechts-/Steuerberatung, nur Vorprüfung).
// Deutsche Förderprogramme ändern sich häufig, deshalb mit lastCheckedAt
// statt fest im Code.
model FundingProgram {
  id          String @id @default(cuid())
  name        String
  provider    String // KFW | BAFA | BUND | LAND | KOMMUNE | SONSTIGE
  appliesTo   String // PV | WAERMEPUMPE | BEIDE
  fundingType String // ZUSCHUSS | KREDIT | STEUERVORTEIL

  description String

  percentageOfCost Float?
  maxAmountEur     Float?

  requiresExistingBuilding Boolean @default(false) // nur Bestandsgebäude
  requiresOwnerOccupied    Boolean @default(false) // nur selbstnutzende Eigentümer
  maxHouseholdIncomeEur    Float? // Einkommensgrenze, falls relevant

  conditions String // übrige Bedingungen als Freitext, manuell zu prüfen
  sourceUrl  String?

  active        Boolean  @default(true)
  lastCheckedAt DateTime
}

// ---------- Angebote ----------

model Offer {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  offerNumber String
  createdAt   DateTime @default(now())
  totalNet    Float?
  totalGross  Float?
}

// ---------- Aufgaben ----------

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("OFFEN") // OFFEN, ERLEDIGT

  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User   @relation("TaskCreator", fields: [createdById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Dateiablage & Pflichtfotos ----------

// Administrierbare Pflichtfoto-Vorgabe je Auftragsvariante (z.B. "Dachübersicht" bei PV).
model RequiredPhotoType {
  id          String @id @default(cuid())
  variantType String // PV | WAERMEPUMPE | KLIMA | WARTUNG | ELEKTROINSTALLATION | HEIZUNG_SANITAER_NEUBAU
  label       String
  sortOrder   Int    @default(0)

  documents Document[]
}

model Document {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // leer = freie Zusatzdatei ohne festen Pflichtfoto-Typ
  requiredPhotoTypeId String?
  requiredPhotoType   RequiredPhotoType? @relation(fields: [requiredPhotoTypeId], references: [id], onDelete: SetNull)

  blobKey  String
  fileName String
  mimeType String

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
}
