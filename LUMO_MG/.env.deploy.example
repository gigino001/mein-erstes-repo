# Zugangsdaten für den Upload auf den Webspace.
# Diese Datei nach .env.deploy kopieren und ausfüllen.
# .env.deploy enthält Zugangsdaten und steht in .gitignore.

# Aus dem ALL-INKL-KAS: Tools → FTP-Accounts
FTP_HOST=wXXXXXX.kasserver.com
FTP_USER=fXXXXXX
FTP_PASSWORD=

# Verzeichnis, in dem die Domain liegt.
# Bei ALL-INKL üblich: /lumo-mg.de  oder  /  wenn der FTP-Zugang
# bereits direkt auf das Domainverzeichnis zeigt.
FTP_REMOTE_DIR=/

# Verschlüsselte Übertragung. Nur auf false setzen, wenn der Hoster
# ausdrücklich kein FTPS anbietet — dann gehen Zugangsdaten im Klartext
# über die Leitung.
FTP_SECURE=true
