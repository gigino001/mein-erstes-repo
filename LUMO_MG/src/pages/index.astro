---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Sunmark from '../components/Sunmark.astro';
import DayArc from '../components/DayArc.astro';
import EventCard from '../components/EventCard.astro';
import MenuList from '../components/MenuList.astro';
import Note from '../components/Note.astro';
import RestaurantSchema from '../components/RestaurantSchema.astro';
import Figure from '../components/Figure.astro';
import Countdown from '../components/Countdown.astro';
import MapConsent from '../components/MapConsent.astro';
import { site, venue, openingLong, openingHours, serviceTimes, TODO } from '../data/site';
import { menu, menuIsPlaceholder } from '../data/menu';
import { images } from '../data/demo';

const now = new Date();
const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const upcoming = all.filter((e) => e.data.date >= now).slice(0, 3);

// Auszug für die Startseite: Brunch und Bar zeigen die Spannweite des Hauses.
const teaserSections = menu.filter((s) => s.id === 'brunch' || s.id === 'drinks');

const hasCapacity = venue.partySeated !== TODO;

// Die Zeiten lagen bestaetigt in site.ts und kamen auf der Startseite nie vor.
const ruhetage = openingHours.filter((d) => !d.from).map((d) => d.day);
const beispielTermine = upcoming.some((e) => e.data.placeholder);
const geoeffnet = openingHours.filter((d) => d.from);
---

<Base title={site.name} path="/">
  {/* ---------------- Hero ---------------- */}
  <header class="hero">
    <div class="hero__inner">
      <Sunmark size="clamp(96px, 17vw, 150px)" />
      <h1 class="hero__word">{site.name}</h1>
      <p class="hero__tagline">{site.tagline.join(' · ')}</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__place">
        {site.address.street} · {site.address.city}
      </p>

      <Countdown />

      <div class="hero__cta">
        <a class="btn" href="/reservieren">Tisch reservieren</a>
        <a class="btn btn--ghost" href="/speisekarte">Zur Karte</a>
      </div>
    </div>

    <p class="hero__scroll" aria-hidden="true"><span></span>Scrollen</p>
  </header>

  {/* ---------------- Tagesverlauf ---------------- */}
  <Section veil="open" id="tag" labelledby="tag-titel">
    <div class="head on-paper reveal">
      <span class="label">Von morgens bis spät</span>
      <h2 id="tag-titel">Ein Ort, der den ganzen Tag trägt</h2>
      <p>
        Bei LUMO endet der Tag nicht nach dem Frühstück. Vom ersten Kaffee bis zum letzten
        Cocktail — ein Bogen, der sich über den ganzen Tag spannt.
      </p>
    </div>

    <DayArc />

    <div class="hours reveal">
      <div class="hours__days">
        {
          geoeffnet.map((d) => (
            <div>
              <dt>{d.short}</dt>
              <dd>
                {d.from} – {d.to}
              </dd>
            </div>
          ))
        }
      </div>
      {
        ruhetage.length > 0 && (
          <p class="hours__closed">
            <strong>{ruhetage.join(' und ')}</strong> ist Ruhetag.
          </p>
        )
      }
      <ul class="hours__service">
        {
          serviceTimes.map((st) => (
            <li>
              <b>{st.title}</b>
              {st.slots.map((slot) => (
                <span>
                  {slot.days} · {slot.from}–{slot.to}
                </span>
              ))}
            </li>
          ))
        }
      </ul>
      <a class="hours__link" href="/kontakt">Alle Zeiten und Anfahrt</a>
    </div>
  </Section>

  {/* ---------------- Das LUMO ---------------- */}
  <Section veil="band" id="lumo" labelledby="lumo-titel">
    <div class="split">
      <div class="copy reveal">
        <span class="label">Das LUMO</span>
        <h2 id="lumo-titel">Modern Boho in Mönchengladbach</h2>
        <p class="lead">{site.claim}</p>
        <p>
          Drapierte Stoffbahnen unter der Decke, Leuchten aus Rattan und Makramee, Olivenbäume in
          schweren Tontöpfen, weiche Bouclé-Sofas an dunklen Holztischen. Handgeschnitzte Paneele an
          der Wand, Kerzenlicht auf jedem Tisch — und hinter der Bar ein Wandbild, das den Raum nach
          Bali öffnet.
        </p>
        <p>
          Auf dem Tisch trifft türkisches Frühstück auf moderne Brunch-Klassiker: Simit und Menemen
          neben Pancakes und Eggs Benedict, dazu Speciality Coffee, eine eigene Matcha-Karte,
          hausgemachte Kuchen und Torten. Abends übernehmen Dinner und Signature Cocktails.
        </p>
        <ul class="pills">
          <li>Türkisches Frühstück</li>
          <li>Speciality Coffee</li>
          <li>Matcha</li>
          <li>Kuchen &amp; Torten</li>
          <li>Signature Cocktails</li>
        </ul>
      </div>

      <div class="figures reveal">
        <Figure
          class="figure--tall"
          src={images.innenraum.src}
          alt={images.innenraum.alt}
          ratio="3 / 5"
          eager
        />
        <Figure src={images.bar.src} alt={images.bar.alt} ratio="1 / 1" hideBadge />
        <Figure src={images.brunch.src} alt={images.brunch.alt} ratio="1 / 1" hideBadge />
      </div>
    </div>
  </Section>

  {/* ---------------- Matcha ---------------- */}
  <Section veil="open" id="matcha" class="matcha" labelledby="matcha-titel">
    <div class="split split--reverse">
      <Figure
        class="reveal"
        src={images.matcha.src}
        alt={images.matcha.alt}
        ratio="16 / 10"
      />

      <div class="copy on-paper reveal">
        <span class="label label--matcha">Matcha at LUMO</span>
        <h2 id="matcha-titel">Mehr als ein Trend</h2>
        <p class="lead">Ein Ritual. Ein Moment. Ein Lebensgefühl.</p>
        <p>
          Eine eigene Auswahl an Matcha-Kreationen — als Drink, als Bowl, als Kuchen. Mit
          hochwertigen Zutaten zubereitet, von der klassischen Zeremonie bis zum Iced Matcha für
          den Nachmittag.
        </p>
        <a class="btn btn--ghost self-start" href="/speisekarte#coffee">Matcha-Karte ansehen</a>
      </div>
    </div>
  </Section>

  {/* ---------------- Auszug aus der Karte ---------------- */}
  <Section veil="dense" id="karte" labelledby="karte-titel">
    <div class="head reveal">
      <span class="label">Küche &amp; Bar</span>
      <h2 id="karte-titel">Ein Auszug aus der Karte</h2>
      <p>Von türkischem Frühstück am Morgen bis zum Signature Cocktail am Abend.</p>
    </div>

    <div class="menu-grid reveal">
      {teaserSections.map((section) => <MenuList section={section} showIntro={false} />)}
    </div>

    <div class="center-cta reveal">
      <a class="btn btn--ink" href="/speisekarte">Vollständige Karte</a>
    </div>

    {
      menuIsPlaceholder && (
        <p class="hint">Ein Vorgeschmack — die vollständige Karte folgt zur Eröffnung.</p>
      )
    }
  </Section>

  {/* ---------------- Events ---------------- */}
  <Section veil="medium" id="events" labelledby="events-titel">
    <div class="head head--left reveal">
      <span class="label">Events</span>
      <h2 id="events-titel">Was als Nächstes läuft</h2>
      <p>
        Live-Musik, DJ-Abende, Themenbrunches und private Feiern — jeder Termin bekommt eine eigene
        Seite, die sich teilen lässt.
      </p>
    </div>

    {
      upcoming.length > 0 ? (
        <div class="events-grid">
          {upcoming.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <p class="empty reveal">
          Zurzeit sind keine Termine eingetragen. Was geplant ist, erfahrt ihr zuerst auf Instagram.
        </p>
      )
    }

    {
      beispielTermine && (
        <p class="hint">Beispieltermine — das echte Programm folgt zur Eröffnung.</p>
      )
    }

    <div class="center-cta reveal">
      <a class="btn btn--ghost" href="/events">Alle Events</a>
    </div>
  </Section>

  {/* ---------------- Feiern ---------------- */}
  <Section veil="open" id="feiern" labelledby="feiern-titel">
    <div class="split">
      <div class="copy on-paper reveal">
        <span class="label">Feiern &amp; Mieten</span>
        <h2 id="feiern-titel">Eure Feier im LUMO</h2>
        <p>
          Geburtstag, Verlobung, Firmenfeier oder Taufe — der Raum lässt sich teilen, komplett
          buchen oder um die Terrasse erweitern. Eigene Menüs, eigene Getränkepauschalen, eigene
          Musik.
        </p>

        {
          hasCapacity ? (
            <dl class="facts">
              <div>
                <dt>Gäste sitzend</dt>
                <dd>{venue.partySeated}</dd>
              </div>
              <div>
                <dt>Gäste stehend</dt>
                <dd>{venue.partyStanding}</dd>
              </div>
            </dl>
          ) : (
            <Note>Die Kapazitäten stehen noch nicht fest und werden ergänzt.</Note>
          )
        }

        <ul class="pills">
          <li>Geburtstag</li>
          <li>Firmenfeier</li>
          <li>Verlobung</li>
          <li>Taufe</li>
          <li>Babyshower</li>
        </ul>

        <a class="btn self-start" href="/feiern">Unverbindlich anfragen</a>
      </div>

      <Figure
        class="reveal"
        src={images.lounge.src}
        alt={images.lounge.alt}
        ratio="3 / 4"
      />
    </div>
  </Section>

  {/* ---------------- Finden ---------------- */}
  <Section veil="band" id="finden" labelledby="finden-titel">
    <div class="split">
      <div class="copy reveal">
        <span class="label">Finden</span>
        <h2 id="finden-titel">{site.address.street}</h2>
        <p>
          {site.address.postalCode} {site.address.city}. {site.parking}.
        </p>
        <p>
          Wir öffnen am <strong>{openingLong}</strong>. Bis dahin halten wir euch auf Instagram
          auf dem Laufenden.
        </p>
        <div class="row">
          <a class="btn btn--ink" href="/kontakt">Anfahrt &amp; Kontakt</a>
          <a class="btn btn--ghost" href={site.instagram.url} rel="noopener noreferrer" target="_blank">
            {site.instagram.handle}
          </a>
        </div>
      </div>

      <div class="reveal">
        <MapConsent />
      </div>
    </div>
  </Section>

  <RestaurantSchema slot="head" />
</Base>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 7rem var(--gutter) 4rem;
  }

  /* Weicher Lichthof hinter der Wortmarke, damit sie auf dem Wandbild steht */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 58% 46% at 50% 46%,
      rgb(253 249 240 / 62%),
      rgb(253 249 240 / 0%) 72%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .hero__word {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-6);
    line-height: 0.9;
    letter-spacing: var(--tracking-brand);
    padding-left: var(--tracking-brand);
    color: var(--ink);
  }

  .hero__tagline {
    font-size: clamp(0.6rem, 2vw, 0.78rem);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .hero__rule {
    display: block;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .hero__place {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .hero__scroll span {
    display: block;
    width: 1px;
    height: 34px;
    background: linear-gradient(180deg, var(--gold), transparent);
  }

  /* ---------------- Kopfblock einer Sektion ---------------- */
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .head h2 {
    font-size: var(--step-4);
  }

  .head p {
    color: var(--ink-soft);
  }

  /* ---------------- Zweispalter ---------------- */
  .split {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 880px) {
    .split {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-xl);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 56ch;
  }

  .copy h2 {
    font-size: var(--step-4);
  }

  .copy p:not(.lead) {
    color: var(--ink-soft);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  /* Frueher mit Rahmen und Versalien — optisch nicht von .btn--ghost zu
     unterscheiden, obwohl sie nichts tun. Jetzt klar als Aufzaehlung. */
  .pills li {
    padding: 0.25rem 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .pills li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-2xs);
    color: var(--gold);
  }

  /* ---------------- Bildraster ---------------- */
  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .figures :global(.figure--tall) {
    grid-row: span 2;
    aspect-ratio: auto !important;
  }
  /* ---------------- Oeffnungszeiten ---------------- */
  .hours {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    max-width: 54rem;
    margin: var(--space-l) auto 0;
    padding: var(--space-m);
    background: rgb(253 249 240 / 94%);
    border: 1px solid var(--line-faint);
    text-align: center;
  }

  .hours__days {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-m);
    margin: 0;
  }

  .hours__days > div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .hours__days dt {
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .hours__days dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
    color: var(--ink);
  }

  .hours__closed {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hours__closed strong {
    color: var(--ink);
  }

  .hours__service {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s) var(--space-m);
    margin: 0;
    padding: var(--space-s) 0 0;
    border-top: 1px solid var(--line-faint);
    list-style: none;
    width: 100%;
  }

  .hours__service li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0;
  }

  .hours__service b {
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .hours__service span {
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .hours__link {
    font-size: var(--step--1);
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hint {
    margin-top: var(--space-m);
    text-align: center;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* ---------------- Ergaenzende Layoutklassen ---------------- */
  .head--left {
    margin-inline: 0;
    text-align: left;
    align-items: flex-start;
  }

  .split--reverse > :first-child {
    order: 2;
  }

  @media (max-width: 879px) {
    .split--reverse > :first-child {
      order: 0;
    }
  }

  .self-start {
    align-self: flex-start;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .center-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-l);
  }

  .menu-grid {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-l);
  }

  @media (min-width: 820px) {
    .menu-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .events-grid {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  @media (min-width: 800px) {
    .events-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty {
    margin-top: var(--space-l);
    color: var(--ink-soft);
  }

  /* Matcha ist der einzige Ort, an dem der Gruenton auftaucht */
  .matcha {
    background-image: radial-gradient(
      ellipse 55% 40% at 78% 30%,
      rgb(90 108 54 / 12%),
      transparent 64%
    );
  }

  .label--matcha {
    color: var(--matcha);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: var(--space-xs) 0 0;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .facts > div {
    padding: var(--space-s);
    background: rgb(253 249 240 / 90%);
  }

  .facts dt {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--gold-light);
  }
</style>
