---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import FormShell from '../components/FormShell.astro';
import MapConsent from '../components/MapConsent.astro';
import Note from '../components/Note.astro';
import {
  site,
  contact,
  openingHours,
  hoursArePlaceholder,
  serviceTimes,
  openContinuously,
  TODO,
} from '../data/site';

const hasPhone = contact.phone !== TODO;
const hasEmail = contact.email !== TODO;
---

<Base
  title="Kontakt & Anfahrt"
  description="So findet ihr das LUMO: Krefelder Straße 221 in Mönchengladbach, mit eigenen Parkplätzen direkt vor dem Haus."
  path="/kontakt"
>
  <PageHeader
    eyebrow="Finden"
    title="Kontakt & Anfahrt"
    lead={`${site.address.street}, ${site.address.postalCode} ${site.address.city}. ${site.parking}.`}
  />

  <Section veil="dense">
    <div class="grid">
      <div class="info">
        <div class="info__block">
          <h2>Adresse</h2>
          <address>
            {site.address.street}<br />
            {site.address.postalCode} {site.address.city}
          </address>
        </div>

        <div class="info__block">
          <h2>Parken</h2>
          <p>{site.parking}. Die Anfahrt erfolgt direkt über die Krefelder Straße.</p>
        </div>

        <div class="info__block">
          <h2>Erreichbar</h2>
          {hasPhone ? (
            <a class="big" href={`tel:${contact.phoneE164}`}>{contact.phone}</a>
          ) : (
            <Note>Telefonnummer folgt.</Note>
          )}
          {hasEmail ? (
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          ) : (
            <Note>E-Mail-Adresse folgt, sobald die Domain eingerichtet ist.</Note>
          )}
          <a href={site.instagram.url} rel="noopener noreferrer" target="_blank">
            Instagram {site.instagram.handle}
          </a>
        </div>

        <div class="info__block">
          <h2>Öffnungszeiten</h2>
          <dl class="hours">
            {
              openingHours.map((day) => (
                <div class:list={['hours__row', { 'hours__row--closed': !day.from }]}>
                  <dt>{day.day}</dt>
                  <dd>{day.from ? `${day.from} – ${day.to}` : 'Ruhetag'}</dd>
                </div>
              ))
            }
          </dl>
          {hoursArePlaceholder && <Note>Die Zeiten sind Platzhalter und stehen noch nicht fest.</Note>}
          {openContinuously && <p class="hours__hint">Durchgehend geöffnet — auch zwischen den Küchenzeiten.</p>}
        </div>

        <div class="info__block">
          <h2>Arbeiten im LUMO</h2>
          <p>
            Wir suchen Verstärkung für Theke, Bar und Service. Schick uns einfach ein paar Zeilen
            zu dir — ein förmliches Anschreiben brauchen wir nicht.
          </p>
          <a href={`mailto:${contact.emailJobs}?subject=Bewerbung`}>{contact.emailJobs}</a>
        </div>

        <div class="info__block">
          <h2>Wann es was gibt</h2>
          <dl class="service">
            {
              serviceTimes.map((s) => (
                <div class="service__item">
                  <dt>{s.title}</dt>
                  <dd>
                    {s.note && <em class="service__note">{s.note}</em>}
                    {s.slots.map((slot) => (
                      <span>
                        {slot.days}
                        <b>
                          {slot.from} – {slot.to}
                        </b>
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="map-wrap">
        <MapConsent />
      </div>
    </div>
  </Section>

  <Section veil="band" labelledby="schreiben">
    <div class="write">
      <div class="write__intro">
        <span class="label">Schreiben</span>
        <h2 id="schreiben">Eine Frage an uns?</h2>
        <p>
          Für Tischreservierungen nutzt bitte das <a href="/reservieren">Reservierungsformular</a>,
          für Feiern die Seite <a href="/feiern">Feiern &amp; Mieten</a> — dort fragen wir gleich
          die richtigen Angaben ab.
        </p>
      </div>

      <FormShell type="kontakt" submitLabel="Nachricht senden">
        <div class="form__row form__row--2">
          <div class="field">
            <label for="name">Name <span class="req">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">E-Mail <span class="req">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label for="nachricht">Nachricht <span class="req">*</span></label>
          <textarea id="nachricht" name="nachricht" required></textarea>
        </div>
      </FormShell>
    </div>
  </Section>
</Base>

<style>
  .grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .info__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .info h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }

  .info address {
    font-style: normal;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .info p {
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .info a {
    color: var(--ink-soft);
    transition: color 0.25s var(--ease);
  }

  .info a:hover {
    color: var(--gold-dark);
  }

  .info .big {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--gold);
  }

  .hours {
    width: 100%;
    max-width: 24rem;
    margin: 0;
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line-faint);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hours__row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .hours__row--closed dd {
    color: var(--ink-faint);
  }

  .service {
    width: 100%;
    max-width: 26rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .service__item dt {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .service__item dd {
    margin: var(--space-2xs) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .service__item dd span {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .service__note {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-bottom: 0.2rem;
  }

  .hours__hint {
    margin-top: var(--space-2xs);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .service__item dd b {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    white-space: nowrap;
  }

  .write {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 900px) {
    .write {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-xl);
    }
  }

  .write__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .write__intro h2 {
    font-size: var(--step-3);
  }

  .write__intro p {
    color: var(--ink-soft);
    max-width: 38ch;
  }

  .write__intro a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
