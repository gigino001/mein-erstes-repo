---
import { Image } from 'astro:assets';
import { demoImages } from '../data/demo';

/*
  Bildfläche der Seite.

  Liegt ein Bild vor, wird es optimiert ausgeliefert (moderne Formate,
  mehrere Größen). Fehlt es, bleibt die gestaltete Platzhalterfläche
  stehen — es entsteht nie ein Loch.

  Solange Demobilder im Einsatz sind, trägt jedes Bild eine kleine
  Kennzeichnung. Sie ist bewusst sichtbar: Diese Bilder zeigen nicht das
  echte Haus, und niemand soll sie dafür halten.
*/
interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Text auf der Platzhalterfläche, falls kein Bild vorliegt */
  placeholder?: string;
  /** Seitenverhältnis der Fläche */
  ratio?: string;
  class?: string;
  /** Für das erste sichtbare Bild — lädt sofort statt verzögert */
  eager?: boolean;
  /** Kennzeichnung ausblenden, z. B. auf sehr kleinen Flächen */
  hideBadge?: boolean;
}

const {
  src,
  alt = '',
  placeholder = 'Foto folgt',
  ratio = '4 / 5',
  class: className = '',
  eager = false,
  hideBadge = false,
} = Astro.props;
---

<figure class={`figure ${className}`} style={`--ratio:${ratio}`}>
  {
    src ? (
      <>
        <Image
          src={src}
          alt={alt}
          widths={[480, 800, 1200, 1800]}
          sizes="(min-width: 880px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          format="webp"
          quality={76}
        />
        {demoImages && !hideBadge && (
          <figcaption class="figure__badge">Demobild</figcaption>
        )}
      </>
    ) : (
      <span class="figure__placeholder">{placeholder}</span>
    )
  }
</figure>

<style>
  .figure {
    position: relative;
    display: flex;
    align-items: flex-end;
    margin: 0;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 50% at 50% 100%, rgb(199 154 84 / 30%), transparent 66%),
      linear-gradient(155deg, #f0e2c7 0%, #e4d3b1 60%, #dac7a0 100%);
  }

  .figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .figure__placeholder {
    padding: var(--space-s);
    font-size: var(--step--2);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(43 33 23 / 50%);
  }

  .figure__badge {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.24em 0.55em;
    background: rgb(43 33 23 / 52%);
    color: rgb(253 249 240 / 88%);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(3px);
  }
</style>
