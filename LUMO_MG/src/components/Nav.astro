---
import Sunmark from './Sunmark.astro';
import { nav, site } from '../data/site';
---

<header class="nav" id="nav">
  <a class="nav__brand" href="/" aria-label={`${site.fullName} — Startseite`}>
    <Sunmark size="2rem" />
    <span class="nav__word">{site.name}</span>
  </a>

  <nav class="nav__links" aria-label="Hauptnavigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="btn btn--sm nav__cta" href="/reservieren">Reservieren</a>

  <button
    class="nav__burger"
    id="nav-burger"
    type="button"
    aria-expanded="false"
    aria-controls="nav-drawer"
    aria-label="Menü öffnen"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<div class="drawer" id="nav-drawer" role="dialog" aria-modal="true" aria-label="Menü" hidden>
  <nav aria-label="Hauptnavigation, mobil">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="btn drawer__cta" href="/reservieren">Reservieren</a>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0.75rem var(--gutter);
    background: rgb(253 249 240 / 0%);
    border-bottom: 1px solid transparent;
    /* Frueher lag hier auch `padding` in der Uebergangsliste. Padding
       loest ein Reflow aus — bei einer klebenden Leiste also bei jedem
       Scrollen. Jetzt wechseln nur noch Farbe und Rand. */
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .nav.is-solid {
    background: rgb(253 249 240 / 93%);
    border-bottom-color: var(--line);
    backdrop-filter: blur(6px);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav__word {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.42em;
    /* gleicht den Leerraum aus, den das Letterspacing rechts erzeugt */
    padding-left: 0.42em;
    color: var(--ink);
  }

  .nav__links {
    display: none;
    gap: var(--space-m);
  }

  .nav__links a {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.25s var(--ease);
  }

  .nav__links a:hover {
    color: var(--gold-dark);
  }

  /* Frueher erst ab 940 px sichtbar. Auf einer knapp 9300 px langen
     Mobilseite gab es damit keinen dauerhaften Weg zur Reservierung —
     nur den Burger. Jetzt steht der Knopf immer da, mobil kompakter. */
  .nav__cta {
    padding: 0.6rem 0.9rem;
    font-size: var(--step--2);
    letter-spacing: 0.12em;
  }

  @media (min-width: 940px) {
    .nav__links {
      display: flex;
    }

    .nav__cta {
      padding: 0.7rem 1.3rem;
      letter-spacing: var(--tracking-wide);
    }
  }

  .nav__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    /* 44 x 44 — darunter ist ein Tippziel mit dem Daumen nicht
       zuverlaessig zu treffen. Vorher 38 x 29. */
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--ink);
    transition:
      transform 0.3s var(--ease),
      opacity 0.2s;
  }

  .nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (min-width: 940px) {
    .nav__burger {
      display: none;
    }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(250 244 232 / 98%);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .drawer a {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--ink);
  }

  .drawer a:hover {
    color: var(--gold-dark);
  }

  .drawer__cta {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    margin-top: var(--space-s);
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const burger = document.getElementById('nav-burger');
  const drawer = document.getElementById('nav-drawer');

  if (nav) {
    const onScroll = () => nav.classList.toggle('is-solid', window.scrollY > 60);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (burger && drawer) {
    let isOpen = false;

    const setOpen = (open: boolean) => {
      isOpen = open;
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) drawer.querySelector<HTMLElement>('a')?.focus();
    };

    burger.addEventListener('click', () => setOpen(!isOpen));
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        setOpen(false);
        burger.focus();
        return;
      }

      /*
        Fokusfalle. Ohne sie wandert der Fokus hinter das Overlay in die
        Seite, die optisch verdeckt ist — wer mit der Tastatur navigiert,
        verliert die Orientierung vollstaendig.
      */
      if (e.key === 'Tab') {
        const focusable = drawer.querySelectorAll<HTMLElement>('a[href], button');
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
