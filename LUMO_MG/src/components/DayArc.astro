---
import { dayArc } from '../data/site';

/*
  Der Sonnenbogen aus der Wortmarke als Tagesverlauf.

  Ab 900 px liegen die Stationen auf berechneten Punkten einer
  Bézier-Kurve. Darunter wird daraus eine senkrechte Zeitachse mit
  demselben Motiv (Linie und Punkte) und denselben Daten.

  Grund: Die frühere Fassung erzwang 820 px Mindestbreite in einem
  335 px breiten Container. Auf dem Handy — laut Projektvorgabe die
  Mehrheit des Verkehrs — sah man „Brunch" und die Hälfte von „Lunch".
  Ein Leitmotiv, das die Mehrheit nicht sehen kann, ist keins.
*/

const P0 = { x: 110, y: 258 };
const C1 = { x: 250, y: 40 };
const C2 = { x: 650, y: 40 };
const P3 = { x: 790, y: 258 };
const VB = { w: 900, h: 295 };

const at = (t: number) => {
  const u = 1 - t;
  return {
    x: u ** 3 * P0.x + 3 * u ** 2 * t * C1.x + 3 * u * t ** 2 * C2.x + t ** 3 * P3.x,
    y: u ** 3 * P0.y + 3 * u ** 2 * t * C1.y + 3 * u * t ** 2 * C2.y + t ** 3 * P3.y,
  };
};

const stops = dayArc.map((stop, i) => {
  const t = i / (dayArc.length - 1);
  const { x, y } = at(t);
  return { ...stop, left: (x / VB.w) * 100, top: (y / VB.h) * 100 };
});
---

<div class="day">
  {/* Bis 899 px: senkrechte Achse */}
  <ol class="day__list reveal">
    {
      stops.map((stop) => (
        <li>
          <span class="day__dot" aria-hidden="true" />
          <b>{stop.title}</b>
          <span class="day__note">{stop.note}</span>
        </li>
      ))
    }
  </ol>

  {/* Ab 900 px: der Bogen */}
  <div class="day__arc reveal" aria-hidden="true">
    <div class="day__canvas">
      <svg viewBox={`0 0 ${VB.w} ${VB.h}`} aria-hidden="true">
        <path
          class="day__path"
          d={`M ${P0.x} ${P0.y} C ${C1.x} ${C1.y}, ${C2.x} ${C2.y}, ${P3.x} ${P3.y}`}
        ></path>
      </svg>

      {
        stops.map((stop) => (
          <p class="day__stop" style={`left:${stop.left}%;top:${stop.top}%`}>
            <span class="day__dot" />
            <b>{stop.title}</b>
            <span class="day__note">{stop.note}</span>
          </p>
        ))
      }
    </div>
  </div>
</div>

<style>
  .day {
    margin-top: var(--space-l);
  }

  /* ---------- senkrechte Achse (Standard) ---------- */
  .day__list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0 0 0 var(--space-m);
    list-style: none;
    border-left: 1px solid var(--line-strong);
  }

  .day__list li {
    position: relative;
    margin: 0;
  }

  .day__list .day__dot {
    position: absolute;
    left: calc(-1 * var(--space-m) - 4px);
    top: 0.55em;
  }

  .day__dot {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px rgb(138 98 32 / 15%);
  }

  .day b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--ink);
  }

  .day__note {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .day__arc {
    display: none;
  }

  /* ---------- Bogen ab 900 px ---------- */
  @media (min-width: 900px) {
    .day__list {
      display: none;
    }

    .day__arc {
      display: block;
    }

    .day__canvas {
      position: relative;
      max-width: 980px;
      height: 295px;
      margin-inline: auto;
    }

    /* Kein preserveAspectRatio="none" mehr — das verzerrte ausgerechnet
       die Strichstärke des Markenmotivs. */
    .day__canvas svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .day__path {
      fill: none;
      stroke: var(--line-strong);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-dasharray: 1400;
      stroke-dashoffset: 1400;
      transition: stroke-dashoffset 2.2s var(--ease);
    }

    .day__arc.is-visible .day__path {
      stroke-dashoffset: 0;
    }

    .day__stop {
      position: absolute;
      /* Feste 9rem ließen die Beschriftungen um bis zu 43 px überlappen.
         Die Breite folgt jetzt dem Abstand der Stationen. */
      width: min(11rem, 15vw);
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .day__stop .day__dot {
      margin: 0 auto var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .day__path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
