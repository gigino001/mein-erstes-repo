---
import { site } from '../data/site';

/*
  Zwei-Klick-Lösung für die Karte.

  Google Maps wird NICHT automatisch geladen. Erst wenn jemand aktiv
  darauf klickt, wird der iframe eingefügt. Vorher geht keine Verbindung
  zu Google und es wird keine IP-Adresse übertragen — genau deshalb
  kommt die Seite ohne Zustimmungsabfrage aus.
*/

const query = encodeURIComponent(
  `${site.address.street}, ${site.address.postalCode} ${site.address.city}`,
);
const embedUrl = `https://www.google.com/maps?q=${query}&output=embed`;
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${query}`;
---

<div class="map" data-map data-embed={embedUrl}>
  <div class="map__placeholder">
    <span class="label">Karte</span>
    <p>
      Die Karte wird erst geladen, wenn du sie anforderst. Dabei baut dein Browser eine Verbindung
      zu Google Maps auf und überträgt deine IP-Adresse. Mehr dazu in unserer
      <a href="/datenschutz">Datenschutzerklärung</a>.
    </p>
    <div class="map__actions">
      <button class="btn btn--sm" type="button" data-map-load>Karte laden</button>
      <a class="btn btn--ghost btn--sm" href={routeUrl} rel="noopener noreferrer" target="_blank">
        Route in Google Maps öffnen
      </a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>('[data-map-load]');
    const embed = container.dataset.embed;
    if (!button || !embed) return;

    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = embed;
      frame.title = 'Standort des LUMO auf Google Maps';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.allowFullscreen = true;
      frame.className = 'map__frame';

      /*
        Frueher tauschte replaceChildren die Flaeche von einem Bild zum
        naechsten aus. Jetzt verblasst der Platzhalter und die Karte kommt
        darunter hervor — dieselbe Flaeche wird erkennbar zu etwas
        anderem, statt zu springen.
      */
      container.classList.add('is-loading');
      window.setTimeout(() => {
        container.replaceChildren(frame);
        requestAnimationFrame(() => container.classList.add('is-loaded'));
      }, 200);
    });
  });
</script>

<style>
  .map {
    position: relative;
    min-height: 22rem;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse 50% 40% at 50% 50%, rgb(199 154 84 / 20%), transparent 70%),
      repeating-linear-gradient(0deg, rgb(247 240 225 / 90%) 0 38px, rgb(232 219 192 / 90%) 38px 39px),
      repeating-linear-gradient(90deg, transparent 0 46px, rgb(232 219 192 / 70%) 46px 47px);
  }

  .map__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    height: 100%;
    min-height: 22rem;
    padding: var(--space-m);
    text-align: center;
  }

  .map__placeholder p {
    max-width: 40ch;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .map__placeholder a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .map__placeholder {
    transition: opacity 0.2s var(--ease-out);
  }

  .map.is-loading .map__placeholder {
    opacity: 0;
  }

  .map :global(.map__frame) {
    display: block;
    width: 100%;
    height: 26rem;
    border: 0;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .map.is-loaded :global(.map__frame) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .map__placeholder,
    .map :global(.map__frame) {
      transition: none;
    }
  }
</style>
